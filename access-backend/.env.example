# ---------------------------------------------------------------- Discord ---
# Onglet OAuth2 de l'application Discord (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Onglet Bot -> Reset Token (le bot ne sert qu'à lire le membre + ses rôles)
DISCORD_BOT_TOKEN=
# ID du serveur Discord qui donne le droit d'utiliser le launcher
DISCORD_GUILD_ID=
# Optionnel : ID du rôle obligatoire en plus (vide = n'importe quel membre)
DISCORD_ACCESS_ROLE_ID=

# ----------------------------------------------------------------- Secrets ---
# openssl rand -base64 48
AUTH_JWT_SECRET=
# openssl rand -base64 32
ADMIN_SECRET=

# -------------------------------------------------------------------- URLs ---
# URL publique du service (Render) ou http://127.0.0.1:8787 en local
PUBLIC_BASE_URL=http://127.0.0.1:8787
# Schémas autorisés à recevoir le code de connexion (séparés par des virgules)
ALLOWED_REDIRECTS=rebootlauncher://auth
# Origines navigateur autorisées en CORS (donc rien pour un launcher desktop)
CORS_ORIGINS=

# ----------------------------------------------------------------- Réglages ---
PORT=8787
DATA_DIR=./data
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
LOGIN_CODE_TTL_SECONDS=120
MAX_DEVICES=2
REQUIRE_DEVICE=false
ACCESS_CACHE_TTL_MS=60000

# ---- Optionnel : seulement pour les tests locaux sans Discord --------------
# DISCORD_API_BASE=https://discord.com/api/v10
# AUTH_ISSUER=reboot-access
# AUTH_AUDIENCE=reboot-launcher
