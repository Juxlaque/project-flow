{
  "name": "reboot-access-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend d'accès Discord (login via bot, contrôle du serveur/rôle, bans, liaison machine) — sans MongoDB",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "init-env": "node scripts/init-env.js",
    "doctor": "node scripts/doctor.js",
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/app.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.7"
  }
}
